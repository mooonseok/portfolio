      "html": "<section class=\"ds-work\"><strong>APC</strong><p>서비스 설명</p></section>",
      "css": ".ds-work{position:relative;padding:24px;color:var(--color-ink,#ebe3cb);background:var(--color-night-2,#14213d);box-shadow:inset 0 0 0 1px rgb(235 227 203 / .32),inset 0 0 0 4px #14213d,inset 0 0 0 5px rgb(235 227 203 / .14)}.ds-work::before{content:\"\";position:absolute;left:14px;right:14px;top:-1px;height:2px;background:var(--color-vermilion,#e0664a)}.ds-work :focus-visible{outline:2px solid var(--color-ink,#ebe3cb)}"
