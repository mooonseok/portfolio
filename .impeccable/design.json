      "css": ".ds-orbit-name{display:inline-flex;align-items:center;gap:7px;padding:6px 8px;font-size:14px;font-weight:500;line-height:1;color:var(--color-dim,#b4ad96);background:var(--color-night-deep,#0b1428);text-shadow:0 0 2px #0b1428,0 0 4px #0b1428,0 0 6px #0b1428,0 0 10px #0b1428}.ds-orbit-name[data-active]{color:var(--color-moonlight,#ebe3cb)}"
